# Токен бота от @BotFather. Не коммитьте заполненный .env.
BOT_TOKEN=

# Секретный ключ OpenAI.
OPENAI_API_KEY=

# Модель Chat Completions.
OPENAI_MODEL=gpt-4.1-mini

# Сколько последних сообщений диалога хранить и передавать в модель (от 1 до 100).
MAX_HISTORY_MESSAGES=100

# Максимум токенов в одном ответе модели.
MAX_OUTPUT_TOKENS=1200
